#!/usr/bin/env bash
# Project hub: index every git repo on this machine, keep them synced with their remotes,
# and serve this repo to the Claude iOS app over Remote Control. See HUB.md.
#   hub scan [--graph]   index repos -> ~/.claude/hub/projects.tsv (--graph: build/refresh graphify graphs too)
#   hub find <word>      look a project up by any part of its path
#   hub pull             fast-forward every repo that has an upstream
#   hub push <repo>...   commit (auto-sync msg) + pull --rebase + push those repos
#   hub serve            start `claude remote-control` for the hub in tmux session "hub"
#   hub selftest         sanity-check push/secret guard against a throwaway repo
#   hub hook-start|hook-touch|hook-stop   Claude Code hooks (claude/settings.json)
set -uo pipefail
H=~/.claude/hub; mkdir -p "$H/graphs" "$H/touched"
INDEX=$H/projects.tsv
HUB_DIR=${HUB_DIR:-$HOME/agentic-coding-setup}
export GIT_TERMINAL_PROMPT=0   # a missing credential fails fast instead of hanging a background job
# never auto-commit these; the repo is skipped and reported instead
SECRETS='(^|/)(\.env(\..*)?|.*\.pem|.*\.key|id_(rsa|ed25519).*|credentials\.json|\.credentials\.json|auth\.json|.*\.sqlite)$'

fail() {
  echo "$(date '+%F %R') $*" | tee -a "$H/failed" >&2
  # optional phone push for sync problems: install the ntfy iOS app, subscribe to a hard-to-guess topic, export HUB_NTFY_TOPIC
  [ -n "${HUB_NTFY_TOPIC:-}" ] && curl -fsS -m 10 -d "hub: $*" "https://ntfy.sh/$HUB_NTFY_TOPIC" >/dev/null 2>&1
  return 0
}
repos() { [ -f "$INDEX" ] || scan >/dev/null; cut -f2 "$INDEX"; }
slug() { local s=${1#$HOME/}; echo "${s//\//_}"; }

scan() {
  local graph=${1:-} p g s
  # ponytail: skips dot-dirs, node_modules, snap; depth 6 covers ~/Github/org/repo/sub; raise if repos live deeper
  find "$HOME" -maxdepth 6 -name .git -prune -printf '%h\n' -o \( -name '.?*' -o -name node_modules -o -name snap \) -prune | sort |
  while read -r p; do
    s=$(slug "$p")
    if [ "$graph" = --graph ] && command -v graphify >/dev/null; then
      if [ -f "$p/graphify-out/graph.json" ]; then timeout 600 graphify update "$p" >/dev/null 2>&1
      else timeout 600 graphify extract "$p" --code-only --out "$H/graphs/$s" >/dev/null 2>&1   # outside the repo: nothing new to commit
      fi
    fi
    g=-; for c in "$p/graphify-out/graph.json" "$H/graphs/$s/graphify-out/graph.json"; do [ -f "$c" ] && { g=$c; break; }; done
    printf '%s\t%s\t%s\t%s\n' "${p#$HOME/}" "$p" "$(git -C "$p" remote get-url origin 2>/dev/null || echo -)" "$g"
  done > "$INDEX.tmp" && mv "$INDEX.tmp" "$INDEX"
  echo "indexed $(wc -l < "$INDEX") repos -> $INDEX"
}

pull() {
  repos | while IFS= read -r r; do
    git -C "$r" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || continue   # local-only repo
    timeout 60 git -C "$r" pull -q --ff-only >/dev/null 2>&1 || fail "$r: can't fast-forward (diverged or offline); next push from a session rebases it"
  done
}

push_one() {
  local r=$1
  cd "$r" 2>/dev/null || return 0
  git rev-parse -q --verify '@{u}' >/dev/null 2>&1 || return 0              # no upstream: nothing to push to
  # only auto-commit to your own repos; shared/org/third-party clones are pull-only
  git remote get-url origin 2>/dev/null | grep -qE "${HUB_PUSH_ONLY:-github\.com[:/]taxpet06/}" || return 0
  if [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
    fail "$r: mid-rebase, left alone"; return 0
  fi
  if [ -n "$(git status --porcelain)" ]; then
    git add -A
    if git diff --cached --name-only | grep -qE "$SECRETS"; then
      git reset -q; fail "$r: secret-looking file would be committed ($(git status --porcelain | grep -E "$SECRETS" | head -3 | tr '\n' ' ')); gitignore it"; return 0
    fi
    git commit -qm "auto-sync from $(hostname)" >/dev/null 2>&1 || { git reset -q; fail "$r: commit failed (pre-commit hook?)"; return 0; }
  fi
  timeout 120 git pull -q --rebase --autostash >/dev/null 2>&1 || { git rebase --abort 2>/dev/null; fail "$r: pull conflicts with remote, resolve by hand"; return 0; }
  [ "$(git rev-list --count '@{u}..HEAD')" -gt 0 ] && { timeout 120 git push -q >/dev/null 2>&1 || fail "$r: push rejected"; }
  return 0
}

push() {
  exec 9>"$H/sync.lock"; flock 9   # ponytail: one global lock; two sessions ending together just queue
  local r; for r in "$@"; do (push_one "$r"); done
}

serve() {
  if tmux has-session -t hub 2>/dev/null; then echo "hub already serving (tmux attach -t hub)"; return; fi
  local c=${HUB_CLAUDE:-$(command -v claude-personal || command -v claude)}
  tmux new-session -d -s hub -c "$HUB_DIR" "$c remote-control --name hub --permission-mode auto; read -p 'remote-control exited, enter to close'"
  echo "hub serving: Claude iOS app -> Code -> session 'hub'   (watch: tmux attach -t hub)"
}

bg() { setsid nohup "$0" "$@" >>"$H/bg.log" 2>&1 </dev/null & }

case "${1:-}" in
  scan) scan "${2:-}" ;;
  find) grep -i -- "${2:?word}" "$INDEX" | cut -f1,2,4 ;;
  pull) pull ;;
  push) shift; push "$@" ;;
  serve) serve ;;
  hook-start)   # stdout lands in the session's context
    if [ -s "$H/failed" ]; then echo "hub sync problems since last session:"; cat "$H/failed"; cat "$H/failed" >> "$H/failed.seen"; : > "$H/failed"; fi
    [ -f "$INDEX" ] || bg scan
    bg pull ;;
  hook-touch)   # PostToolUse Edit|Write: remember which repo this session changed
    jq -r '[.session_id, (.tool_input.file_path // .tool_input.notebook_path // "")] | @tsv' | {
      IFS=$'\t' read -r sid f
      [ -n "$f" ] && git -C "$(dirname "$f")" rev-parse --show-toplevel >> "$H/touched/$sid" 2>/dev/null
    }; true ;;
  hook-stop)    # Stop (end of every turn): push repos this session touched, plus its cwd's repo
    IFS=$'\t' read -r sid cwd < <(jq -r '[.session_id, .cwd] | @tsv')
    t="$H/touched/$sid"
    list=$( { cat "$t" 2>/dev/null; git -C "$cwd" rev-parse --show-toplevel 2>/dev/null; } | sort -u)
    rm -f "$t"
    mapfile -t L <<< "$list"
    [ -n "$list" ] && bg push "${L[@]}"
    true ;;
  selftest)
    export HUB_PUSH_ONLY=.; T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
    git init -q --bare "$T/remote.git" && git clone -q "$T/remote.git" "$T/w" 2>/dev/null
    git -C "$T/w" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init && git -C "$T/w" push -q -u origin HEAD 2>/dev/null
    git -C "$T/w" config user.name t; git -C "$T/w" config user.email t@t
    echo hi > "$T/w/a.txt"; push "$T/w"
    [ "$(git -C "$T/remote.git" log --oneline | wc -l)" = 2 ] || { echo "FAIL: change not pushed"; exit 1; }
    echo X=1 > "$T/w/.env"; push "$T/w" 2>/dev/null
    [ "$(git -C "$T/remote.git" log --oneline | wc -l)" = 2 ] || { echo "FAIL: .env was pushed"; exit 1; }
    tail -1 "$H/failed" | grep -q "$T/w" && sed -i '$d' "$H/failed"   # don't leave the test's warning for the next session
    echo "selftest ok" ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
