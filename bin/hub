#!/usr/bin/env bash
# Shim: the hub CLI is hub/cli.mjs (Node, so it runs the same on Linux, macOS and Windows). bootstrap.sh installs
# launchers with the repo path baked in; this one works when run from the repo or through a symlink.
exec node "${HUB_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}/hub/cli.mjs" "$@"
